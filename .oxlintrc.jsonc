{
	"$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
	"extends": ["./node_modules/@effect/tsgo/oxlint-presets/strict.json"],
	"plugins": ["typescript", "unicorn", "oxc", "import", "vitest", "promise"],
	"ignorePatterns": ["node_modules", ".turbo"],
	"rules": {
		"effecttsgo/any-unknown-in-error-context": "error",
		"effecttsgo/crypto-random-uuid-in-effect": "error",
		"effecttsgo/effect-try-without-catch": "error",
		"effecttsgo/experimental-api-usage": "off",
		"effecttsgo/global-console-in-effect": "error",
		"effecttsgo/global-date-in-effect": "error",
		"effecttsgo/global-fetch-in-effect": "error",
		"effecttsgo/global-random-in-effect": "error",
		"effecttsgo/global-timers-in-effect": "error",
		"effecttsgo/map-map-error-to-map-both": "error",
		"effecttsgo/nested-effect-gen-yield": "error",
		"effecttsgo/prefer-schema-type-property": "error",
		"effecttsgo/process-env-in-effect": "error",
		"effecttsgo/promise-all-in-effect": "error",
		"effecttsgo/promise-race-in-effect": "error",
		"effecttsgo/provide-merge-all-to-array": "error",
		"effecttsgo/schema-union-of-literals": "error",
		"effecttsgo/service-not-as-class": "error",
		"effecttsgo/unsafe-effect-type-assertion": "error",
		"effecttsgo/unstable-api-usage": "off",
		"oxc/no-accumulating-spread": "error",
		"typescript/no-explicit-any": "error",
		"typescript/no-require-imports": "error",
		"typescript/ban-ts-comment": [
			"error",
			{ "ts-expect-error": { "descriptionFormat": "^ -- boundary: \\S" } },
		],
		"typescript/no-array-delete": "error",
		"typescript/no-extra-non-null-assertion": "error",
		"typescript/no-for-in-array": "error",
		"typescript/no-misused-new": "error",
		"typescript/no-non-null-asserted-nullish-coalescing": "error",
		"import/no-cycle": "error",
		"import/no-self-import": "error",
		"import/no-duplicates": "error",
		"eslint/no-self-compare": "error",
		"eslint/no-case-declarations": "error",
		"eslint/no-proto": "error",
		"eslint/no-regex-spaces": "error",
		"eslint/no-restricted-imports": [
			"error",
			{
				"paths": [
					{
						"name": "@earendil-works/pi-durable",
						"importNames": ["defineDoc", "defineDocFamily"],
						"allowTypeImports": true,
						"message": "Declare Checkfu Pi documents in apps/api/src/Pi/PiDocRegistry.ts so they are covered by Persisted.lock.json.",
					},
					{
						"name": "effect/workflow",
						"importNames": ["Activity"],
						"allowTypeImports": true,
						"message": "Declare RunTurn workflow activities through runTurnActivity in packages/sessions/src/Session/RunTurnActivities.ts so they are covered by Persisted.lock.json.",
					},
				],
			},
		],
		"eslint/no-restricted-properties": [
			"error",
			{
				"property": "defineDoc",
				"message": "Declare Checkfu Pi documents in apps/api/src/Pi/PiDocRegistry.ts so every persisted Pi document is covered by Persisted.lock.json.",
			},
			{
				"property": "defineDocFamily",
				"message": "Declare Checkfu Pi document families in apps/api/src/Pi/PiDocRegistry.ts so every persisted Pi document family is covered by Persisted.lock.json.",
			},
		],
		"eslint/no-sequences": "error",
		"promise/no-new-statics": "error",
		"promise/no-return-in-finally": "error",
		"promise/valid-params": "error",
		"unicorn/prefer-number-properties": "error",
		"vitest/no-focused-tests": "error",
		"vitest/no-disabled-tests": "error",
		"vitest/expect-expect": "off",
	},
	"overrides": [
		{
			"files": ["apps/api/src/Pi/PiDocRegistry.ts"],
			"rules": {
				"eslint/no-restricted-imports": "off",
				"eslint/no-restricted-properties": "off",
			},
		},
		{
			"files": ["packages/sessions/src/Session/RunTurnActivities.ts"],
			"rules": {
				"eslint/no-restricted-imports": "off",
			},
		},
		{
			"files": ["**/*.story.{test,spec}.ts"],
			"rules": {
				"promise/valid-params": "off",
			},
		},
	],
}

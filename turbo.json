{
	"$schema": "https://turborepo.com/schema.json",
	"globalDependencies": ["tsconfig.base.json", "patches/**"],
	"cacheMaxSize": "2GB",
	"futureFlags": {
		"affectedUsingTaskInputs": true
	},
	"tasks": {
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			"dependsOn": ["^typecheck"]
		},
		"@checkfu/api#typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/alchemy.run.ts"]
		},
		"@checkfu/api#test": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/alchemy.run.ts",
				"$TURBO_ROOT$/packages/domain/src/Artifact/types/**"
			]
		},
		"@checkfu/domain#test": {
			"dependsOn": ["^typecheck"],
			"env": ["CHECKFU_PROVE"],
			"passThroughEnv": ["GITHUB_ACTIONS"]
		},
		"@checkfu/cli#test": {
			"dependsOn": ["^typecheck"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/package.json", "$TURBO_ROOT$/bunfig.toml"]
		},
		"@checkfu/release#test": {
			"dependsOn": ["^typecheck"],
			"cache": false
		}
	}
}

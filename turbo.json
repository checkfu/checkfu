{
	"$schema": "https://turborepo.com/schema.json",
	"globalDependencies": ["tsconfig.base.json"],
	"futureFlags": {
		"affectedUsingTaskInputs": true
	},
	"tasks": {
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			"dependsOn": ["^typecheck"]
		},
		"@checkfu/api#typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/alchemy.run.ts",
				"$TURBO_ROOT$/scripts/sync-state-store-observability.ts"
			]
		},
		"@checkfu/api#test": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/alchemy.run.ts",
				"$TURBO_ROOT$/scripts/sync-state-store-observability.ts"
			]
		},
		"@checkfu/cli#test": {
			"dependsOn": ["^typecheck"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/README.md", "$TURBO_ROOT$/package.json"]
		}
	}
}

{
	"name": "checkfu",
	"private": true,
	"license": "Apache-2.0",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@alchemy.run/domain": "https://pkg.alchemy.run/@alchemy.run/domain/-/e85b3a6a00e28386e60e208e52f03d66b08cbfcd275db59b83ef83f8730df7f9.tgz",
			"@effect/platform-node": "4.1.5",
			"@effect/vitest": "4.1.5",
			"alchemy": "https://pkg.alchemy.run/alchemy/-/76bc7521b3b218d6de95626c9bed1e2107937587092c5c27c9afa41371225228.tgz",
			"effect": "4.1.5",
			"typescript": "7.0.2",
			"vitest": "5.1.1"
		}
	},
	"type": "module",
	"scripts": {
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"lint": "oxlint -c .oxlintrc.jsonc --disable-nested-config --type-aware --deny-warnings --report-unused-disable-directives .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
	},
	"devDependencies": {
		"@effect/tsgo": "0.73.2",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"oxlint-tsgolint": "7.0.2007",
		"turbo": "2.11.13",
		"typescript": "catalog:"
	},
	"overrides": {
		"effect": "4.1.5"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"packageManager": "bun@1.4.2",
	"trustedDependencies": [
		"esbuild"
	]
}

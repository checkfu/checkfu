{
	"name": "checkfu",
	"private": true,
	"license": "Apache-2.0",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*",
			"tools/*"
		],
		"catalog": {
			"@alchemy.run/cloudflare": "https://pkg.alchemy.run/@alchemy.run/cloudflare/-/934b80b15c5ae2bf2be4dd44e478713f9755b51b53f8218ab22eec555b2bae72.tgz",
			"@alchemy.run/domain": "https://pkg.alchemy.run/@alchemy.run/domain/-/d3c8dbf7b350aa08ddf41791ae5d834f2eb57f96df420795f5ec9a5db1b45b96.tgz",
			"@cloudflare/computer": "0.11.4",
			"@cloudflare/forge": "0.2.0",
			"@distilled.cloud/cloudflare": "https://pkg.alchemy.run/@distilled.cloud/cloudflare/-/8ce7588c1725c1b71f5cdbf5fed6c7fdac2192f915d16e06e03dfe9a8e36a464.tgz",
			"@earendil-works/chord": "1.6.0",
			"@earendil-works/pi-ai": "1.6.0",
			"@earendil-works/pi-codemode": "1.6.0",
			"@earendil-works/pi-durable": "1.6.0",
			"@earendil-works/pi-schema": "1.6.0",
			"@platformatic/vfs": "0.4.1",
			"@effect/platform-bun": "4.1.5",
			"@effect/platform-node": "4.1.5",
			"@effect/vitest": "4.1.5",
			"@modelcontextprotocol/server": "2.4.0",
			"@modelcontextprotocol/client": "2.4.0",
			"@types/node": "26.6.6",
			"agents": "0.34.0",
			"alchemy": "https://pkg.alchemy.run/alchemy/-/099477e46ca2063d281240b2b9f220fa2bfb094de47f1dddc26cc7b067248cab.tgz",
			"effect": "4.1.5",
			"fast-check": "4.9.0",
			"modern-tar": "0.8.6",
			"typescript": "7.0.2",
			"vitest": "5.1.1",
			"yaml": "2.9.1",
			"zod": "4.6.7"
		}
	},
	"type": "module",
	"scripts": {
		"generate": "bun tools/forge/src/Generate.ts",
		"generate:check": "bun tools/forge/src/Generate.ts --check",
		"checkfu": "bun --no-env-file --config=apps/cli/bunfig.toml apps/cli/src/main.ts",
		"checkfu:build": "bun run --cwd apps/cli build",
		"dev": "alchemy dev",
		"deploy": "alchemy deploy",
		"deploy:production": "bun run persisted:check && alchemy deploy --stage production",
		"destroy": "alchemy destroy",
		"typecheck": "turbo run typecheck --output-logs=errors-only --continue && effect-tsgo tsc --noEmit -p tsconfig.stack.json",
		"test": "turbo run test --output-logs=errors-only --continue",
		"test:bun": "bun --cwd apps/api test:bun",
		"test:workerd": "bun --cwd apps/api test:workerd",
		"lint": "bun tools/forge/src/CheckDirectives.ts && effect-tsgo oxlint --disable-nested-config --type-aware --deny-warnings --report-unused-disable-directives .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"prepare": "bun .githooks/install.mjs",
		"check": "bun run generate:check && bun run format:check && bun run lint --type-check",
		"persisted:check": "bun apps/api/test/persisted/main.ts check",
		"persisted:cut": "bun apps/api/test/persisted/main.ts cut",
		"release:build": "bun tools/release/Build.ts"
	},
	"dependencies": {
		"@alchemy.run/cloudflare": "catalog:",
		"@alchemy.run/domain": "catalog:",
		"@distilled.cloud/cloudflare": "catalog:",
		"@effect/platform-bun": "catalog:",
		"alchemy": "catalog:",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/forge": "catalog:",
		"@cloudflare/oxlint-config": "0.1.0",
		"@effect/tsgo": "0.73.2",
		"lefthook": "2.2.2",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"oxlint-tsgolint": "7.0.2007",
		"tsrs": "0.25.0-ts7.1.0-beta",
		"turbo": "2.11.13",
		"typescript": "catalog:"
	},
	"overrides": {
		"effect": "4.1.5"
	},
	"engines": {
		"bun": ">=1.4.0",
		"node": "^22.18.0 || ^24.0.0 || >=26.0.0"
	},
	"packageManager": "bun@1.4.2",
	"patchedDependencies": {
		"@alchemy.run/domain@https://pkg.alchemy.run/@alchemy.run/domain/-/d3c8dbf7b350aa08ddf41791ae5d834f2eb57f96df420795f5ec9a5db1b45b96.tgz": "patches/@alchemy.run%2Fdomain@https%3A%2F%2Fpkg.alchemy.run%2F@alchemy.run%2Fdomain%2F-%2Fd3c8dbf7b350aa08ddf41791ae5d834f2eb57f96df420795f5ec9a5db1b45b96.tgz.patch"
	},
	"trustedDependencies": [
		"esbuild"
	]
}

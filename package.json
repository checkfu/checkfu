{
	"name": "checkfu",
	"private": true,
	"license": "Apache-2.0",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*",
			"tools/*"
		],
		"catalog": {
			"@alchemy.run/cloudflare": "https://pkg.alchemy.run/@alchemy.run/cloudflare/-/d49aab2e8f5ab9abbec4b4bcbd8d4d7b428c14143eb0e20a07eba6b5194ade5d.tgz",
			"@alchemy.run/domain": "https://pkg.alchemy.run/@alchemy.run/domain/-/300073173839ac69f7f76fd46021bdc13ce7386471bda71ff2b930b6f319f117.tgz",
			"@cloudflare/forge": "0.2.0",
			"@distilled.cloud/cloudflare": "https://pkg.alchemy.run/@distilled.cloud/cloudflare/-/8ce7588c1725c1b71f5cdbf5fed6c7fdac2192f915d16e06e03dfe9a8e36a464.tgz",
			"@earendil-works/chord": "1.6.0",
			"@earendil-works/pi-ai": "1.6.0",
			"@earendil-works/pi-durable": "1.6.0",
			"@earendil-works/pi-schema": "1.6.0",
			"@effect/platform-bun": "4.1.5",
			"@effect/platform-node": "4.1.5",
			"@effect/vitest": "4.1.5",
			"@types/node": "26.6.6",
			"agents": "0.34.0",
			"alchemy": "https://pkg.alchemy.run/alchemy/-/3882966d5d3b5229ec2df019a1d53902e85bd720a17326cf3e24c6bba3cb78bc.tgz",
			"effect": "4.1.5",
			"typescript": "7.0.2",
			"vitest": "5.1.1",
			"yaml": "2.9.1"
		}
	},
	"type": "module",
	"scripts": {
		"generate": "bun tools/forge/src/Generate.ts",
		"generate:check": "bun tools/forge/src/Generate.ts --check",
		"checkfu:build": "bun run --cwd apps/cli build",
		"dev": "alchemy dev",
		"deploy": "alchemy deploy",
		"deploy:production": "bun run persisted:check && alchemy deploy --stage production",
		"destroy": "alchemy destroy",
		"typecheck": "turbo run typecheck && effect-tsgo tsc --noEmit -p tsconfig.stack.json",
		"test": "turbo run test",
		"test:bun": "bun --cwd apps/api test:bun",
		"test:workerd": "bun --cwd apps/api test:workerd",
		"lint": "effect-tsgo oxlint --disable-nested-config --type-aware --deny-warnings --report-unused-disable-directives .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"check": "bun run generate:check && bun run format:check && bun run lint && bun run typecheck && bun run test",
		"persisted:check": "bun apps/api/test/persisted/main.ts check",
		"persisted:cut": "bun apps/api/test/persisted/main.ts cut"
	},
	"dependencies": {
		"@alchemy.run/cloudflare": "catalog:",
		"@alchemy.run/domain": "catalog:",
		"@checkfu/api": "workspace:*",
		"@checkfu/mcp": "workspace:*",
		"@distilled.cloud/cloudflare": "catalog:",
		"@effect/platform-bun": "catalog:",
		"alchemy": "catalog:",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/forge": "catalog:",
		"@cloudflare/oxlint-config": "0.1.0",
		"@effect/tsgo": "0.73.2",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"oxlint-tsgolint": "7.0.2007",
		"tsrs": "0.25.0-ts7.1.0-beta",
		"turbo": "2.11.13",
		"typescript": "catalog:"
	},
	"overrides": {
		"effect": "4.1.5"
	},
	"engines": {
		"bun": ">=1.4.0",
		"node": "^22.18.0 || ^24.0.0 || >=26.0.0"
	},
	"packageManager": "bun@1.4.2",
	"trustedDependencies": [
		"esbuild"
	]
}

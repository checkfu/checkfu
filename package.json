	"type": "module",
	"scripts": {
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"lint": "oxlint -c .oxlintrc.jsonc --disable-nested-config --type-aware --deny-warnings --report-unused-disable-directives .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
		"persisted:cut": "bun apps/api/test/persisted/cut.ts"
	},
	"dependencies": {
		"@alchemy.run/cloudflare": "catalog:",
		"@alchemy.run/domain": "catalog:",
		"@checkfu/api": "workspace:*",
		"@distilled.cloud/cloudflare": "catalog:",

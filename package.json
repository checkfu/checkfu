{
	"name": "checkfu",
	"private": true,
	"license": "Apache-2.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"typecheck": "turbo run typecheck",
		"lint": "oxlint -c .oxlintrc.jsonc --disable-nested-config --type-aware --deny-warnings --report-unused-disable-directives --no-error-on-unmatched-pattern .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"check": "bun run format:check && bun run lint && bun run typecheck"
	},
	"devDependencies": {
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"oxlint-tsgolint": "7.0.2007",
		"turbo": "2.11.13",
		"typescript": "7.0.2"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"packageManager": "bun@1.4.2"
}

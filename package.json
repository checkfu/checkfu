		"alchemy": "catalog:",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@effect/tsgo": "0.73.2",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"oxlint-tsgolint": "7.0.2007",
		"turbo": "2.11.13",
		"typescript": "catalog:"
	},
	"overrides": {
		"effect": "4.1.5"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"packageManager": "bun@1.4.2",
	"trustedDependencies": [
		"esbuild"
	]
}

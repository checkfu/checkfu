# Secret clients send in `Authorization: Bearer <key>` or `x-api-key: <key>`.
# Leave it empty and `bun checkfu deploy` generates one, or run: openssl rand -hex 32
CHECKFU_API_KEY=

# Set at least one model provider API key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Where Durable Objects keep their data. Decide before the first
# deploy: an object inside a jurisdiction is a different object from the one
# with the same name outside it, so changing CHECKFU_JURISDICTION later starts
# from empty. CHECKFU_LOCATION_HINT only affects objects created after it is set.
# CHECKFU_JURISDICTION: eu | fedramp
# CHECKFU_LOCATION_HINT: wnam | enam | sam | weur | eeur | apac | oc | afr | me
CHECKFU_JURISDICTION=
CHECKFU_LOCATION_HINT=

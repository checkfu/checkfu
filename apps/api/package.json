{
	"name": "@checkfu/api",
	"version": "0.0.0",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./*": "./src/*.ts"
	},
	"scripts": {
		"typecheck": "effect-tsgo tsc --noEmit",
		"test": "vitest run --pool=threads --no-allowOnly",
		"test:bun": "bun --bun run vitest run --pool=threads --no-allowOnly --reporter=default --reporter=./test/helpers/RequireProviderFetchTests.ts test/ProviderFetch.bun.test.ts",
		"test:workerd": "vitest run --config test/workerd/vitest.config.ts --no-allowOnly"
	},
	"dependencies": {
		"@alchemy.run/cloudflare": "catalog:",
		"@alchemy.run/domain": "catalog:",
		"@checkfu/domain": "workspace:*",
		"@checkfu/pi-providers": "workspace:*",
		"@checkfu/sdk": "workspace:*",
		"@checkfu/snapshots": "workspace:*",
		"@cloudflare/computer": "catalog:",
		"@distilled.cloud/cloudflare": "catalog:",
		"@earendil-works/chord": "catalog:",
		"@earendil-works/pi-ai": "catalog:",
		"@earendil-works/pi-codemode": "catalog:",
		"@earendil-works/pi-durable": "catalog:",
		"@earendil-works/pi-schema": "catalog:",
		"@platformatic/vfs": "catalog:",
		"agents": "catalog:",
		"alchemy": "catalog:",
		"effect": "catalog:",
		"modern-tar": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@effect/platform-bun": "catalog:",
		"@effect/vitest": "catalog:",
		"@modelcontextprotocol/client": "catalog:",
		"@modelcontextprotocol/server": "catalog:",
		"fast-check": "catalog:",
		"vitest": "catalog:"
	}
}

{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256,
			"description": "Human-readable agent name"
		},
		"model": {
			"anyOf": [
				{
					"type": "string",
					"minLength": 1
				},
				{
					"type": "object",
					"properties": {
						"id": {
							"type": "string",
							"minLength": 1
						}
					},
					"required": ["id"],
					"additionalProperties": false
				}
			],
			"description": "Model ID string or model object ({id})"
		},
		"system": {
			"anyOf": [
				{
					"type": "string",
					"maxLength": 100000
				},
				{
					"type": "null"
				}
			],
			"description": "System prompt text"
		},
		"description": {
			"anyOf": [
				{
					"type": "string",
					"maxLength": 2048
				},
				{
					"type": "null"
				}
			],
			"description": "Agent description"
		},
		"mcp_servers": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"type": {
						"type": "string",
						"enum": ["url"]
					},
					"name": {
						"type": "string",
						"minLength": 1,
						"maxLength": 32,
						"pattern": "^[A-Za-z0-9-]+(?:_[A-Za-z0-9-]+)*$"
					},
					"url": {
						"type": "string",
						"maxLength": 2048,
						"pattern": "^(?:https:\\/\\/[^\\s/?#@]+|http:\\/\\/(?:localhost|127\\.0\\.0\\.1|\\[::1\\])(?::\\d{1,5})?)(?:[/?#]\\S*)?$"
					}
				},
				"required": ["type", "name", "url"],
				"additionalProperties": false
			},
			"maxItems": 20,
			"description": "MCP servers whose tools the agent may use. Each tool is offered as mcp__<server>__<tool>."
		},
		"tools": {
			"type": "array",
			"items": {
				"anyOf": [
					{
						"type": "object",
						"properties": {
							"type": {
								"type": "string",
								"enum": ["mcp_toolset"]
							},
							"mcp_server_name": {
								"type": "string",
								"minLength": 1,
								"maxLength": 32,
								"pattern": "^[A-Za-z0-9-]+(?:_[A-Za-z0-9-]+)*$"
							},
							"default_config": {
								"type": "object",
								"properties": {
									"permission_policy": {
										"type": "object",
										"properties": {
											"type": {
												"type": "string",
												"enum": ["always_allow", "always_ask"]
											}
										},
										"required": ["type"],
										"additionalProperties": false
									}
								},
								"additionalProperties": false,
								"description": "Applies to tools without their own configuration. MCP tools require confirmation by default."
							},
							"configs": {
								"type": "array",
								"items": {
									"type": "object",
									"properties": {
										"name": {
											"type": "string",
											"minLength": 1,
											"maxLength": 128
										},
										"permission_policy": {
											"type": "object",
											"properties": {
												"type": {
													"type": "string",
													"enum": ["always_allow", "always_ask"]
												}
											},
											"required": ["type"],
											"additionalProperties": false
										}
									},
									"required": ["name"],
									"additionalProperties": false
								},
								"maxItems": 128
							}
						},
						"required": ["type", "mcp_server_name"],
						"additionalProperties": false
					},
					{
						"type": "object",
						"properties": {
							"type": {
								"type": "string",
								"enum": ["custom"]
							},
							"name": {
								"type": "string",
								"pattern": "^[A-Za-z0-9_-]{1,64}$"
							},
							"description": {
								"type": "string",
								"minLength": 1,
								"maxLength": 4096
							},
							"input_schema": {
								"type": "object"
							}
						},
						"required": ["type", "name", "description", "input_schema"],
						"additionalProperties": false
					}
				]
			},
			"maxItems": 84,
			"description": "Permission policies for MCP servers' tools (mcp_toolset) and custom tools the caller's application runs (custom)."
		},
		"type": {
			"type": "string",
			"enum": ["agent"]
		},
		"$schema": {
			"type": "string"
		}
	},
	"required": ["name", "model"],
	"additionalProperties": false
}

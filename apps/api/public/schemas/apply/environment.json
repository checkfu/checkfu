{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 256,
			"description": "Human-readable environment name"
		},
		"description": {
			"anyOf": [
				{
					"type": "string",
					"maxLength": 1024
				},
				{
					"type": "null"
				}
			],
			"description": "Environment description"
		},
		"config": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"enum": ["cloud"]
				},
				"networking": {
					"anyOf": [
						{
							"type": "object",
							"properties": {
								"type": {
									"type": "string",
									"enum": ["unrestricted"]
								}
							},
							"required": ["type"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"type": {
									"type": "string",
									"enum": ["limited"]
								},
								"allow_mcp_servers": {
									"type": "boolean"
								},
								"allow_package_managers": {
									"type": "boolean"
								},
								"allowed_hosts": {
									"type": "array",
									"items": {
										"type": "string",
										"minLength": 1
									}
								}
							},
							"required": ["type", "allow_mcp_servers", "allow_package_managers", "allowed_hosts"],
							"additionalProperties": false
						}
					]
				}
			},
			"required": ["type", "networking"],
			"additionalProperties": false,
			"description": "Environment configuration object"
		},
		"type": {
			"type": "string",
			"enum": ["environment"]
		},
		"$schema": {
			"type": "string"
		}
	},
	"required": ["name"],
	"additionalProperties": false
}

{
	"name": "@checkfu/cli",
	"version": "0.0.2",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./*": "./src/*.ts"
	},
	"scripts": {
		"build": "bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --define CHECKFU_STANDALONE=true src/main.ts --outfile dist/checkfu",
		"typecheck": "effect-tsgo tsc --noEmit",
		"test": "vitest run --pool=threads --no-allowOnly --testTimeout=20000"
	},
	"dependencies": {
		"@alchemy.run/cloudflare": "catalog:",
		"@checkfu/authoring": "workspace:*",
		"@checkfu/pi-providers": "workspace:*",
		"@checkfu/sdk": "workspace:*",
		"@effect/platform-bun": "catalog:",
		"alchemy": "catalog:",
		"effect": "catalog:",
		"jsonc-parser": "3.3.1",
		"modern-tar": "catalog:",
		"yaml": "catalog:"
	},
	"devDependencies": {
		"@alchemy.run/domain": "catalog:",
		"@checkfu/api": "workspace:*",
		"@checkfu/domain": "workspace:*",
		"@effect/platform-node": "catalog:",
		"@effect/vitest": "catalog:",
		"vitest": "catalog:"
	}
}
